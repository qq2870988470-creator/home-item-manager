APP_ENV=production
# Relative paths are resolved from this project's directory, never from the caller's cwd.
# fnOS example: /vol1/docker/home-item-manager/data (use your actual shared directory)
DATA_ROOT=./data
STORAGE_ROOT=./storage
POSTGRES_DB=home_items
POSTGRES_USER=homeapp
POSTGRES_PASSWORD=change_me
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis
CACHE_TTL=600
# Mac: loopback. Trusted NAS LAN: set a NAS LAN IP, or 0.0.0.0 with firewall rules.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
